# Aegis on Solana — Environment Configuration (.env is gitignored)

# ─── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent keypair — use a JSON array of bytes, e.g. [12,34,...] or a file path
# Generate with: solana-keygen new --outfile agent-keypair.json
AGENT_KEYPAIR=~/.config/solana/id.json

# ─── Aegis Program ────────────────────────────────────────────────────────────
# Program ID: C67pkvsssWAB8j6vPmAfb2WB8uWWiPmkYfqEjK8HaG6L
AEGIS_PROGRAM_ID=C67pkvsssWAB8j6vPmAfb2WB8uWWiPmkYfqEjK8HaG6L

# Exit asset mints (Devnet / Mainnet)
# USDC Devnet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# USDC Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
WSOL_MINT=So11111111111111111111111111111111111111112
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# ─── AI (Claude Policy Parser) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Agent behaviour ──────────────────────────────────────────────────────────
# Set to "false" to enable real transaction execution (default: true = dry run)
DRY_RUN=true

# Poll interval in milliseconds (default: 30000 = 30 seconds)
POLL_INTERVAL_MS=30000

# ─── xStocks API ──────────────────────────────────────────────────────────────
# Public API, no key required. Override only if using a local proxy.
XSTOCKS_API_BASE=https://api.xstocks.fi/api/v2
