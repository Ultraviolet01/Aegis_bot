# ─── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com

# Agent keypair — use a JSON array of bytes, e.g. [12,34,...] or a file path
# Generate with: solana-keygen new --outfile agent-keypair.json
AGENT_KEYPAIR=~/.config/solana/agent-keypair.json

# ─── Aegis Program ────────────────────────────────────────────────────────────
# Set after first `anchor deploy` — the deploy output prints the program ID
AEGIS_PROGRAM_ID=AeGiSXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC mint on the target cluster
# Devnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Agent behaviour ──────────────────────────────────────────────────────────
# Set to "false" to enable real transaction execution (default: true = dry run)
DRY_RUN=true

# Poll interval in milliseconds (default: 30000 = 30 seconds)
POLL_INTERVAL_MS=30000

# ─── xStocks API ──────────────────────────────────────────────────────────────
# Public API, no key required. Override only if using a local proxy.
XSTOCKS_API_BASE=https://api.xstocks.fi/api/v2
